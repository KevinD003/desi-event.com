{
  "name": "desi-event",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desi-Event \u2014 event discovery and ticketing platform for the South Asian community. JavaScript-only monorepo.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @desi-event/db run generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,jsx,json,md,css,yml,yaml}\"",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @desi-event/web test:e2e",
    "policy:check": "node scripts/check-language-policy.mjs",
    "ci:check": "node scripts/check-ci-invariants.mjs",
    "contract:check": "pnpm --filter @desi-event/api-contract run validate && pnpm --filter @desi-event/api run openapi:check",
    "verify": "pnpm run policy:check && pnpm run ci:check && pnpm run secrets:scan && pnpm run format:check && pnpm run lint && pnpm run test && pnpm run build",
    "db:generate": "pnpm --filter @desi-event/db run generate",
    "db:migrate": "pnpm --filter @desi-event/db run migrate",
    "db:migrate:deploy": "pnpm --filter @desi-event/db run migrate:deploy",
    "db:reset": "pnpm --filter @desi-event/db run reset",
    "db:seed": "pnpm --filter @desi-event/db run seed",
    "db:studio": "pnpm --filter @desi-event/db run studio",
    "openapi:check": "pnpm --filter @desi-event/api run openapi:check",
    "openapi:emit": "pnpm --filter @desi-event/api run openapi:emit",
    "clean": "node scripts/clean.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "test:e2e:prod": "pnpm --filter @desi-event/web test:e2e:prod",
    "load": "node scripts/load/run.mjs",
    "db:verify:fresh": "pnpm --filter @desi-event/db run verify:fresh",
    "db:verify:upgrade": "pnpm --filter @desi-event/db run verify:upgrade",
    "test:e2e:organizer": "pnpm --filter @desi-event/web run test:e2e:organizer",
    "test:e2e:events": "pnpm --filter @desi-event/web run test:e2e:events",
    "bundle:scan": "node scripts/scan-browser-bundle.mjs",
    "manifest:emit": "pnpm --filter @desi-event/api-contract run manifest:emit",
    "test:e2e:refusals": "pnpm --filter @desi-event/web run test:e2e:refusals",
    "verify:tests:fresh": "node scripts/verify-tests-fresh.mjs",
    "skips:check": "node scripts/check-skipped-tests.mjs",
    "test:e2e:sweep": "pnpm --filter @desi-event/web run test:e2e:sweep",
    "test:e2e:detail": "pnpm --filter @desi-event/web run test:e2e:detail",
    "test:e2e:analytics": "pnpm --filter @desi-event/web run test:e2e:analytics",
    "test:e2e:reconciliation": "pnpm --filter @desi-event/web run test:e2e:reconciliation",
    "test:e2e:refunds": "pnpm --filter @desi-event/web run test:e2e:refunds",
    "test:e2e:transfers": "pnpm --filter @desi-event/web run test:e2e:transfers"
  },
  "devDependencies": {
    "@desi-event/auth": "workspace:*",
    "@desi-event/config": "workspace:*",
    "@desi-event/db": "workspace:*",
    "@desi-event/logger": "workspace:*",
    "@desi-event/providers": "workspace:*",
    "@desi-event/schemas": "workspace:*",
    "@eslint/js": "^9.39.0",
    "dotenv": "^17.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^64.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  }
}
