{
  "name": "@desi-event/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desi-Event REST API — Fastify on Node.js, validated with Zod, documented with OpenAPI.",
  "main": "./src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node scripts/emit-openapi.mjs --check",
    "openapi:check": "node scripts/emit-openapi.mjs --check",
    "openapi:emit": "node scripts/emit-openapi.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@desi-event/api-contract": "workspace:*",
    "@desi-event/auth": "workspace:*",
    "@desi-event/db": "workspace:*",
    "@desi-event/inventory": "workspace:*",
    "@desi-event/logger": "workspace:*",
    "@desi-event/permissions": "workspace:*",
    "@desi-event/pricing": "workspace:*",
    "@desi-event/providers": "workspace:*",
    "@desi-event/schemas": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "ioredis": "^6.0.0",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5",
    "@desi-event/ledger": "workspace:*"
  },
  "devDependencies": {
    "@desi-event/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
