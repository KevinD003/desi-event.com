    "@desi-event/providers": "workspace:*",
    "@desi-event/schemas": "workspace:*",
    "bullmq": "^6.3.6",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@desi-event/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
