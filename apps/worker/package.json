{
  "name": "@desi-event/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background job processors — BullMQ on Redis for holds, email, payouts and search indexing.",
  "main": "./src/main.js",
  "scripts": {
    "dev": "node --watch src/main.js",
    "start": "node src/main.js",
    "lint": "eslint .",
