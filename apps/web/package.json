{
  "name": "@desi-event/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desi-Event web app — Next.js App Router, React and JSX, styled with Tailwind CSS.",
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start --port ${WEB_PORT:-3000}",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "pnpm run build && playwright test --config playwright.production.config.js",
    "test:e2e:organizer": "ORGANIZER_E2E_TAG=e2e$(date +%s) playwright test --config playwright.organizer.config.js",
    "test:e2e:events": "EVENTS_E2E_TAG=e2e$(date +%s) playwright test --config playwright.events.config.js",
    "test:e2e:refusals": "playwright test --config playwright.refusals.config.js",
    "test:e2e:sweep": "playwright test --config playwright.sweep.config.js",
    "test:e2e:detail": "playwright test --config playwright.detail.config.js",
    "test:e2e:analytics": "DETAIL_E2E_SPEC=**/detail-analytics.spec.js playwright test --config playwright.detail.config.js",
    "test:e2e:reconciliation": "DETAIL_E2E_SPEC=**/detail-reconciliation.spec.js playwright test --config playwright.detail.config.js",
    "test:e2e:refunds": "DETAIL_E2E_SPEC=**/detail-refunds.spec.js playwright test --config playwright.detail.config.js",
    "test:e2e:transfers": "DETAIL_E2E_SPEC=**/detail-transfers.spec.js playwright test --config playwright.detail.config.js"
  },
  "dependencies": {
    "@desi-event/api-contract": "workspace:*",
    "@desi-event/inventory": "workspace:*",
    "@desi-event/pricing": "workspace:*",
    "@desi-event/schemas": "workspace:*",
    "@desi-event/ui": "workspace:*",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@desi-event/auth": "workspace:*",
    "@desi-event/config": "workspace:*",
    "@desi-event/db": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
