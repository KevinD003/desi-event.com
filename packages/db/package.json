{
  "name": "@desi-event/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations, seed data and the shared PostgreSQL client.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "seed": "node scripts/seed.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:fresh": "node scripts/verify-fresh-database.mjs",
    "verify:upgrade": "node scripts/verify-populated-upgrade.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "@desi-event/config": "workspace:*",
    "@desi-event/logger": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
