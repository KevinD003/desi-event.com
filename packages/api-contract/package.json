{
  "name": "@desi-event/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST/OpenAPI contract: route descriptors shared by the Fastify server and the web client.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "node scripts/validate-contract.mjs"
  },
  "dependencies": {
    "@desi-event/permissions": "workspace:*",
    "@desi-event/schemas": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@desi-event/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
