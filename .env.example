# ---------------------------------------------------------------------------
# Desi-Event environment template. Copy to .env and adjust for your machine.
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL — the single source of truth for application data.
DATABASE_URL=postgresql://desi:desi@127.0.0.1:5432/desi_event?schema=public
# Separate database used by integration tests so they can be reset freely.
TEST_DATABASE_URL=postgresql://desi:desi@127.0.0.1:5432/desi_event_test?schema=public

# Redis — cache plus BullMQ queue transport.
REDIS_URL=redis://127.0.0.1:6379

# Fastify API
API_HOST=0.0.0.0
API_PORT=4000
# Generate a strong value for anything other than local development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-any-deploy
JWT_EXPIRES_IN=7d

# Next.js web app
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Pricing — platform fee applied on top of ticket face value.
# 590 bps = 5.90%, plus a flat 99 cents per ticket.
PLATFORM_FEE_BPS=590
PLATFORM_FEE_FLAT_CENTS=99

# How long a checkout hold keeps inventory reserved, in seconds.
TICKET_HOLD_TTL_SECONDS=600

# Tax rates shipped with this repository are marked DEMO: they were carried
# from seed data and a checkout mock-up, not from a tax determination. Nobody
# has confirmed registration status, place-of-supply rules or rate bands.
#
# In production the API refuses to price an order under a DEMO policy. Setting
# this to true accepts illustrative rates anyway, which is a decision somebody
# has to make on purpose and own. Leave it false and configure a real
# determination instead.
ALLOW_DEMO_TAX_IN_PRODUCTION=false

# ---------------------------------------------------------------------------
# Payments
#
# There is no payment integration. Checkout runs against an in-memory provider
# that authorises, captures and refunds nothing, and no code in this repository
# opens a socket to a payment service provider. Real card processing is a
# Phase 2 prerequisite: it needs a merchant account, signed webhooks,
# reconciliation, refunds, payouts and a tax determination.
#
# So there is nothing to configure here, and configuring it anyway is an
# error rather than a no-op. The API and the worker both refuse to start when
# the environment carries a live-looking payment credential (sk_live_…,
# whsec_…, rzp_live_… and friends) or asks for production payments through
# PAYMENT_PROVIDER, PAYMENT_MODE, ENABLE_PRODUCTION_PAYMENTS or similar:
# somebody who believes they have enabled card payments has to find out from
# the boot log rather than from a buyer. A sandbox key left behind is reported
# as unused and ignored.
