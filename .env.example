# ---------------------------------------------------------------------------
# Desi-Event environment template. Copy to .env and adjust for your machine.
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL — the single source of truth for application data.
DATABASE_URL=postgresql://desi:desi@127.0.0.1:5432/desi_event?schema=public
# Separate database used by integration tests so they can be reset freely.
TEST_DATABASE_URL=postgresql://desi:desi@127.0.0.1:5432/desi_event_test?schema=public

# Redis — cache plus BullMQ queue transport.
REDIS_URL=redis://127.0.0.1:6379

# Fastify API
API_HOST=0.0.0.0
API_PORT=4000
# Generate a strong value for anything other than local development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-any-deploy
JWT_EXPIRES_IN=7d

# Next.js web app
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Pricing — platform fee applied on top of ticket face value.
# 590 bps = 5.90%, plus a flat 99 cents per ticket.
PLATFORM_FEE_BPS=590
PLATFORM_FEE_FLAT_CENTS=99

# How long a checkout hold keeps inventory reserved, in seconds.
TICKET_HOLD_TTL_SECONDS=600

# Tax rates shipped with this repository are marked DEMO: they were carried
# from seed data and a checkout mock-up, not from a tax determination. Nobody
# has confirmed registration status, place-of-supply rules or rate bands.
#
# In production the API refuses to price an order under a DEMO policy. Setting
# this to true accepts illustrative rates anyway, which is a decision somebody
# has to make on purpose and own. Leave it false and configure a real
# determination instead.
ALLOW_DEMO_TAX_IN_PRODUCTION=false

# ---------------------------------------------------------------------------
# Payments
#
# Desi-Event runs in exactly one of two modes, and neither of them moves real
# money. There is no third mode: production card processing is a Phase 2 exit
# criterion — a merchant account, reconciliation operations, real refunds, real
# payouts and a tax determination, none of which is in this repository.
#
#   mock         The default, and what you get by leaving this whole section
#                alone. An in-memory provider authorises, captures and refunds
#                nothing, and no code opens a socket to a payment service.
#                Every artefact it produces is labelled DEMO. This is what a
#                fresh clone, CI, a preview deployment and a credential-free
#                demonstration all run, and it is enough to exercise checkout,
#                refunds, the ledger, tickets and check-in end to end.
#
#   stripe_test  Stripe's sandbox, reached only by setting PAYMENT_MODE and
#                supplying a coherent set of *test* credentials on purpose.
#                Test keys, test connected accounts, signed test webhooks. Every
#                artefact it produces is labelled SANDBOX.
#
# Anything that means real money is refused before the server opens a port —
# not logged, not degraded, refused. That covers a live secret or publishable
# key, a live Connect or restricted key, PAYMENT_MODE=live (or production, prod,
# real, stripe, stripe_live), and any attempt to ask for production payments
# through ENABLE_PRODUCTION_PAYMENTS, PAYMENTS_LIVE, STRIPE_LIVE_MODE and
# friends. The check runs in the API and in the worker, before either connects
# to anything, and it cannot be reached from a browser: a client-exposed
# variable (NEXT_PUBLIC_…) carrying a payment mode or a secret is itself a
# refusal. Somebody who believes they have enabled card payments has to find
# out from the boot log rather than from a buyer.
#
# Leave unset for mock. Set to stripe_test only alongside the credentials below.
# PAYMENT_MODE=mock

# --- Stripe test mode -------------------------------------------------------
#
# Required as a coherent set: PAYMENT_MODE=stripe_test with any of these
# missing is refused, and so is a set that mixes test and live values. Get them
# from the Stripe dashboard with test mode switched on. Never commit real
# values — this file carries names and descriptions only.
#
# Secret key, server-side only. Must begin sk_test_; a restricted key
# (rk_test_) is refused, because the adapter's Connect and refund calls need
# the full test key. Never sent to the browser, never logged, never stored.
# STRIPE_SECRET_KEY=
#
# Publishable key, safe to expose. Must begin pk_test_. The web app reads
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY; either name works server-side.
# STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
#
# Signing secret for the account webhook endpoint, from `stripe listen` or from
# the endpoint's page in the dashboard. Begins whsec_. Stripe spells test and
# live signing secrets identically, so this one is checked for coherence with
# the keys above rather than by its prefix.
# STRIPE_WEBHOOK_SECRET=
#
# Signing secret for the Connect webhook endpoint. A separate endpoint with a
# separate secret, because connected-account events arrive with an account
# context and must not be verifiable with the account endpoint's secret.
# STRIPE_CONNECT_WEBHOOK_SECRET=
#
# The API version every request and every stored webhook payload is
# interpreted against. Pinned in code (packages/schemas/src/payments.js) so an
# SDK upgrade cannot silently change the shape of what arrives. Override only
# to test a specific version deliberately.
# STRIPE_API_VERSION=

# --- Stripe Connect ---------------------------------------------------------
#
# Organiser payouts use destination charges on test-mode connected accounts;
# the reasoning is in docs/adr/0003-stripe-connect-charge-model.md. Connect
# needs no variables of its own beyond the keys above. Any that the onboarding
# work turns out to need will be listed here when the code reads them, not
# before.
